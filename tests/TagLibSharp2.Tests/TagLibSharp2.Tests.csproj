<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- Relax analysis for test projects -->
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<!-- Verify 33 requires a SponsorCheck declaration. This repository is MIT and has no revenue. The publisher caps the exemption at 12 months. -->
		<Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
		<Verify_SponsorshipExemptionUntil>2027-11</Verify_SponsorshipExemptionUntil>
		<NoWarn>$(NoWarn);CA1707;CA1515;MSTEST0037;CA1310;CA1806;MSTEST0032</NoWarn>
		<!-- Kit/KitProgram.cs is the entry point: the depth tests run this assembly as a child process. -->
		<GenerateProgramFile>false</GenerateProgramFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MSTest" />
		<PackageReference Include="PublicApiGenerator" />
		<PackageReference Include="Verify.MSTest" />
	</ItemGroup>

	<ItemGroup>
		<!-- What exiftool shows for the generated Exif inputs; regenerate with tools/exif/golden.sh. -->
		<EmbeddedResource Include="Image/Golden/*.txt" LogicalName="Golden.%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\TagLibSharp2\TagLibSharp2.csproj" />
	</ItemGroup>

</Project>
